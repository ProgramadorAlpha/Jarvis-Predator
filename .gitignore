.venv/
__pycache__/
*.py[cod]
.claude/
# Graphify: version the portable knowledge-graph snapshot, never machine state,
# extraction caches, temporary chunks, credentials, or local query history.
graphify-out/*
!graphify-out/README.md
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
config/api_keys.json
memory/long_term.json
logs/
models/
runtime/
.env
